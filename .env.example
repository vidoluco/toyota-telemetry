# MyToyota app credentials (same as the phone app). Copy to .env, never commit .env.
MYTOYOTA_USERNAME=you@example.com
MYTOYOTA_PASSWORD=changeme

# What you actually pay at the pump. These seed a fresh database; afterwards the settings
# box in the dashboard wins, and a tank log with real prices per fill wins over both.
# Left unset, the dashboard falls back to 1.75 EUR/l and labels every cost a placeholder.
TOYOTA_FUEL_PRICE=1.75
TOYOTA_CURRENCY=EUR
